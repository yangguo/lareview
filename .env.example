# LA Review Agent — environment variables
# Copy to .env for local development and fill values as needed.

# Workspace root for file uploads. Uploaded files land in $COZE_WORKSPACE_PATH/assets/uploads/.
# Defaults to current working directory if not set.
COZE_WORKSPACE_PATH=.

# Set to DEV to enable uvicorn reload mode for local development.
COZE_PROJECT_ENV=DEV

# OpenAI-compatible LLM provider. The agent uses langchain_openai.ChatOpenAI.
# Leave OPENAI_BASE_URL unset to use the default OpenAI API endpoint.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# CORS origins for the frontend (comma-separated). Defaults to http://localhost:3000.
# FRONTEND_ORIGINS=http://localhost:3000

# Frontend-only: backend URL used by the Next.js upload proxy and SSE streaming.
# NEXT_PUBLIC_API_URL=http://localhost:8000
